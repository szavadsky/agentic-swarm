diff --git a/bootstrap/run/self-rotate.yaml b/bootstrap/run/self-rotate.yaml
new file mode 100644
index 0000000..9913138
--- /dev/null
+++ b/bootstrap/run/self-rotate.yaml
@@ -0,0 +1,75 @@
+# Self-run with a rotating implementer. Iteration N uses rotation entry N mod 3
+# (iteration 1 pi, 2 codex, 3 opencode), so no harness-specific assumption in
+# the task flow survives untested. Models are the ones the acpx probes ran
+# (bootstrap/context/acpx-probe.md); the owner adopts rotation by copying this
+# file over self.yaml.
+aliases:
+  architect:
+    harness: omp
+    model: anthropic/claude-opus-5-5
+    effort: high
+    fallbacks:
+      - opencode-go/deepseek-v4.1-flash
+  pm:
+    harness: opencode
+    model: opencode-go/deepseek-v4.1-flash
+    effort: high
+    escalateTo: escalation
+    fallbacks:
+      - opencode/deepseek-v4.1-flash-free
+  digest:
+    harness: opencode
+    model: opencode/beam-free
+    effort: max
+    fallbacks:
+      - opencode-go/deepseek-v4.1-flash
+  implementer:
+    # Rotation crosses harnesses, so a single same-harness fallback list cannot
+    # apply to every entry; the entry's model is the fallback-free primary.
+    harness: opencode
+    model: opencode/beam-free
+    effort: high
+    rotate:
+      - harness: opencode
+        model: opencode/beam-free
+        effort: high
+      - harness: pi
+        model: opencode-go/beam-free
+        effort: high
+      - harness: codex
+        model: deepseek-v4.1-flash
+        effort: high
+  reviewer:
+    harness: opencode
+    model: opencode/minimax-m3.1-flash-free
+    fallbacks:
+      - opencode-go/deepseek-v4.1-flash
+  escalation:
+    harness: omp
+    model: anthropic/claude-sonnet-5-5
+
+scouts:
+  model: opencode-go/deepseek-v4.1-flash
+
+# USD per million tokens. A model absent here is unpriced (unknown), never $0;
+# free models are listed explicitly at 0. Cache writes are priced at the input
+# rate because the table carries no separate write rate.
+prices:
+  anthropic/claude-opus-5-5: { input: 4, cachedInput: 0.2, output: 20, reasoning: 20 }
+  anthropic/claude-sonnet-5-5: { input: 2, cachedInput: 0.1, output: 10, reasoning: 10 }
+  opencode/beam-free: { input: 0, cachedInput: 0, output: 0, reasoning: 0 }
+  opencode/deepseek-v4.1-flash-free: { input: 0, cachedInput: 0, output: 0, reasoning: 0 }
+  opencode/minimax-m3.1-flash-free: { input: 0, cachedInput: 0, output: 0, reasoning: 0 }
+  opencode-go/beam-free: { input: 0, cachedInput: 0, output: 0, reasoning: 0 }
+  opencode-go/deepseek-v4.1-flash: { input: 0.15, cachedInput: 0.003, output: 0.6, reasoning: 0.6 }
+  deepseek-v4.1-flash: { input: 0.15, cachedInput: 0.003, output: 0.6, reasoning: 0.6 }
+
+limits:
+  concurrency: 3
+  iterations: 1
+
+sessions:
+  dir: ~/.local/share/factory/sessions
+  keepRuns: 5
+
+worktreeRoot: ~/.local/share/factory/worktrees
diff --git a/plugins/software-factory/test/kernel/rotation.test.ts b/plugins/software-factory/test/kernel/rotation.test.ts
new file mode 100644
index 0000000..b98ffc1
--- /dev/null
+++ b/plugins/software-factory/test/kernel/rotation.test.ts
@@ -0,0 +1,285 @@
+import { describe, expect, it } from "bun:test";
+import fs from "node:fs";
+import path from "node:path";
+import { FakeHarness, fakeTurnResult } from "../../src/harness/fake/index.js";
+import { derive } from "../../src/kernel/derive.js";
+import { runDispatch } from "../../src/kernel/dispatch.js";
+import {
+  frontTarget,
+  resolveRole,
+  resumeSessionFor,
+  stepTarget,
+} from "../../src/kernel/flow-context.js";
+import { ensureTaskWorktree } from "../../src/kernel/worktree.js";
+import { task } from "./helpers.js";
+import {
+  cleanupFlowRepo,
+  goalCheckout,
+  makeRuntime,
+  outcome,
+  setupFlowRepo,
+  writeTask,
+} from "./s2-helpers.js";
+
+/** Iteration 1 routes to `other`, iteration 2 back to `fake`. */
+const ROTATING_IMPLEMENTER = {
+  implementer: {
+    harness: "fake",
+    model: "base-impl",
+    fallbacks: ["base-fallback"],
+    rotate: [
+      { harness: "fake", model: "base-impl" },
+      { harness: "other", model: "other-impl" },
+    ],
+  },
+  reviewer: { harness: "fake", model: "fake-review" },
+};
+
+function writeOwnFile(req: Parameters<FakeHarness["turn"]>[0], text: string): void {
+  const slug = path.basename(req.cwd!);
+  fs.writeFileSync(path.join(req.cwd!, `${slug}.txt`), text, "utf8");
+}
+
+function implementHandler(req: Parameters<FakeHarness["turn"]>[0], ctx: { writeOutcome(value: unknown): void }) {
+  writeOwnFile(req, "implemented\n");
+  ctx.writeOutcome(outcome({ summary: "implemented" }));
+  return fakeTurnResult(req);
+}
+
+function approveHandler(req: Parameters<FakeHarness["turn"]>[0], ctx: { writeOutcome(value: unknown): void }) {
+  writeOwnFile(req, "reviewed\n");
+  ctx.writeOutcome(outcome({ summary: "approved", verdict: "approve" }));
+  return fakeTurnResult(req);
+}
+
+describe("alias rotation", () => {
+  it("routes iteration N through entry N mod length and keeps alias-level fallbacks", async () => {
+    const { repo, goal } = setupFlowRepo({
+      aliases: {
+        ...ROTATING_IMPLEMENTER,
+        "rotated-tier": {
+          harness: "fake",
+          model: "tier-base",
+          rotate: [
+            { harness: "fake", model: "tier-base" },
+            { harness: "other", model: "tier-other" },
+          ],
+        },
+      },
+    });
+    try {
+      const runtime = await makeRuntime(repo, goal, {
+        fake: new FakeHarness({ id: "fake" }),
+        other: new FakeHarness({ id: "other" }),
+      });
+
+      expect(resolveRole(runtime, "implementer", { iteration: 1 })).toMatchObject({
+        alias: "implementer",
+        harnessId: "other",
+        model: { id: "other-impl" },
+        fallbacks: ["base-fallback"],
+      });
+      const second = resolveRole(runtime, "implementer", { iteration: 2 });
+      expect(second.harnessId).toBe("fake");
+      expect(second.model.id).toBe("base-impl");
+      expect(resolveRole(runtime, "implementer", { iteration: 3 }).harnessId).toBe("other");
+
+      // A tier is an alias name; that alias resolves its own rotation.
+      expect(
+        resolveRole(runtime, "implementer", { alias: "rotated-tier", iteration: 1 })
+      ).toMatchObject({ alias: "rotated-tier", harnessId: "other", model: { id: "tier-other" } });
+
+      // `default` is the reserved "no override" name.
+      expect(
+        resolveRole(runtime, "implementer", { alias: "default", iteration: 2 }).alias
+      ).toBe("implementer");
+    } finally {
+      cleanupFlowRepo(repo);
+    }
+  }, 60_000);
+
+  it("dispatches two iterations on the rotated harness of one alias", async () => {
+    const { repo, goal } = setupFlowRepo({ aliases: ROTATING_IMPLEMENTER });
+    try {
+      const fake = new FakeHarness({ id: "fake" });
+      const other = new FakeHarness({ id: "other" });
+      other.script(implementHandler);
+      fake.script(approveHandler);
+      fake.script(implementHandler);
+      fake.script(approveHandler);
+
+      const runtime = await makeRuntime(repo, goal, { fake, other });
+      await writeTask(runtime, task("alpha", { scope: ["alpha.txt"] }));
+      expect((await runDispatch(runtime, { iteration: 1 })).reason).toBe("boundary");
+      await writeTask(runtime, task("beta", { scope: ["beta.txt"] }));
+      expect((await runDispatch(runtime, { iteration: 2 })).reason).toBe("boundary");
+
+      const implement = (await runtime.store.listRecords())
+        .filter((r) => r.alias === "implementer" && r.step === "implement")
+        .sort((a, b) => a.seq - b.seq);
+      expect(implement.map((r) => r.iteration)).toEqual([1, 2]);
+      expect(implement.map((r) => r.session?.harness)).toEqual(["other", "fake"]);
+      expect(implement.map((r) => r.model?.id)).toEqual(["other-impl", "base-impl"]);
+      expect(other.calls).toHaveLength(1);
+      expect(other.calls[0]!.model.id).toBe("other-impl");
+    } finally {
+      cleanupFlowRepo(repo);
+    }
+  }, 60_000);
+
+  it("rotates a trivial task's front handoff and refuses to pin a rotating front turn", async () => {
+    const { repo, goal, goalDir } = setupFlowRepo({
+      aliases: {
+        front: {
+          harness: "fake",
+          model: "fake-front",
+          rotate: [
+            { harness: "fake", model: "fake-front" },
+            { harness: "other", model: "other-front" },
+          ],
+        },
+        implementer: { harness: "fake", model: "base-impl" },
+        reviewer: { harness: "fake", model: "fake-review" },
+      },
+    });
+    try {
+      const runtime = await makeRuntime(repo, goal, {
+        fake: new FakeHarness({ id: "fake" }),
+        other: new FakeHarness({ id: "other" }),
+      });
+      fs.writeFileSync(path.join(goalDir, "class.yaml"), "class: trivial\nslug: tiny\n", "utf8");
+      const taskFile = task("tiny", { flow: "just-implement" });
+      const state = derive([taskFile], [], runtime.configs.process.flows).tasks.tiny!;
+
+      expect(stepTarget(runtime, taskFile, state, "implement", 1)).toMatchObject({
+        role: "implementer",
+        harnessId: "other",
+        model: { id: "other-front" },
+      });
+      // front.ts does not pass the loop's iteration yet (out of this task's
+      // scope), so a rotating front alias must fail loudly, not pin one entry.
+      expect(() => frontTarget(runtime)).toThrow(/without an iteration/);
+    } finally {
+      cleanupFlowRepo(repo);
+    }
+  }, 60_000);
+
+  it("does not resume an iteration-1 session on the iteration-2 rotated harness", async () => {
+    const { repo, goal } = setupFlowRepo({ aliases: ROTATING_IMPLEMENTER });
+    try {
+      const fake = new FakeHarness({ id: "fake" });
+      const other = new FakeHarness({ id: "other" });
+      other.script(implementHandler);
+      fake.script(approveHandler);
+
+      const runtime = await makeRuntime(repo, goal, { fake, other });
+      await writeTask(runtime, task("task", { scope: ["task.txt"] }));
+      expect((await runDispatch(runtime, { iteration: 1 })).reason).toBe("boundary");
+
+      const records = await runtime.store.listRecords();
+      const taskFile = (await runtime.store.listTasks()).find((t) => t.slug === "task")!;
+      const worktree = (await ensureTaskWorktree(runtime, taskFile)).path;
+      const recorded = records.find((r) => r.slug === "task" && r.step === "implement")!.session!;
+      expect(recorded.harness).toBe("other");
+
+      const recordedHarness = resolveRole(runtime, "implementer", { iteration: 1 });
+      const rotatedHarness = resolveRole(runtime, "implementer", { iteration: 2 });
+      expect(
+        (await resumeSessionFor(runtime, taskFile, recordedHarness, records, worktree))?.id
+      ).toBe(recorded.id);
+      expect(
+        await resumeSessionFor(runtime, taskFile, rotatedHarness, records, worktree)
+      ).toBeUndefined();
+    } finally {
+      cleanupFlowRepo(repo);
+    }
+  }, 60_000);
+
+  it("resolves a conflict-merge turn on the rotated entry and resumes its session", async () => {
+    const { repo, goal } = setupFlowRepo({ aliases: ROTATING_IMPLEMENTER });
+    const checkout = goalCheckout(repo, goal);
+    try {
+      const fake = new FakeHarness({ id: "fake" });
+      const other = new FakeHarness({ id: "other" });
+      other.script((req, ctx) => {
+        fs.writeFileSync(path.join(req.cwd!, "conflict.txt"), "task\n", "utf8");
+        ctx.writeOutcome(outcome({ summary: "task side" }));
+        return fakeTurnResult(req);
+      });
+      fake.script((req, ctx) => {
+        fs.writeFileSync(path.join(checkout, "conflict.txt"), "integration\n", "utf8");
+        repo.git(["add", "conflict.txt"], { cwd: checkout });
+        repo.git(["commit", "-m", "concurrent integration change"], { cwd: checkout });
+        ctx.writeOutcome(outcome({ summary: "approved", verdict: "approve" }));
+        return fakeTurnResult(req);
+      });
+      other.script((req, ctx) => {
+        expect(req.prompt).toContain("Conflicted files: conflict.txt");
+        fs.writeFileSync(path.join(req.cwd!, "conflict.txt"), "resolved\n", "utf8");
+        ctx.writeOutcome(outcome({ summary: "conflict resolved" }));
+        return fakeTurnResult(req);
