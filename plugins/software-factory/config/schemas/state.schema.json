{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://software-factory/schemas/state.schema.json",
  "title": "StateArtifact",
  "type": "object",
  "required": [
    "task",
    "status",
    "iteration",
    "items",
    "concerns",
    "lastUpdated"
  ],
  "properties": {
    "task": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "blocked",
        "done",
        "failed"
      ]
    },
    "iteration": {
      "type": "integer",
      "minimum": 1
    },
    "currentWave": {
      "type": "integer",
      "minimum": 1
    },
    "items": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "kind",
          "status"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "branch": {
            "type": "string"
          },
          "attempts": {
            "type": "integer"
          },
          "fixRounds": {
            "type": "integer"
          },
          "spendUsd": {
            "type": "number",
            "minimum": 0
          },
          "currentStep": {
            "type": "string"
          },
          "assignedAt": {
            "type": "string"
          },
          "mergedAt": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "concerns": {
      "type": "object",
      "required": [
        "open",
        "dismissed",
        "routed",
        "resolved"
      ],
      "properties": {
        "open": {
          "type": "integer",
          "minimum": 0
        },
        "dismissed": {
          "type": "integer",
          "minimum": 0
        },
        "routed": {
          "type": "integer",
          "minimum": 0
        },
        "resolved": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "debt": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "budgetSpentUsd": {
      "type": "number",
      "minimum": 0
    },
    "spendByRole": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["costUsd", "inputTokens", "outputTokens"],
        "properties": {
          "costUsd": { "type": "number", "minimum": 0 },
          "inputTokens": { "type": "number", "minimum": 0 },
          "outputTokens": { "type": "number", "minimum": 0 }
        },
        "additionalProperties": false
      }
    },
    "spendByItem": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["costUsd", "inputTokens", "outputTokens"],
        "properties": {
          "costUsd": { "type": "number", "minimum": 0 },
          "inputTokens": { "type": "number", "minimum": 0 },
          "outputTokens": { "type": "number", "minimum": 0 }
        },
        "additionalProperties": false
      }
    },
    "lastUpdated": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
