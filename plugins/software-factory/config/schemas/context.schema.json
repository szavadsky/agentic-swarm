{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://software-factory/schemas/context.schema.json",
  "title": "ContextArtifact",
  "oneOf": [
    {
      "type": "object",
      "required": ["citations"],
      "properties": {
        "citations": {
          "type": "array",
          "items": { "$ref": "#/definitions/Citation" }
        }
      },
      "additionalProperties": false
    },
    {
      "type": "array",
      "items": { "$ref": "#/definitions/Citation" }
    }
  ],
  "definitions": {
    "Citation": {
      "type": "object",
      "required": ["file", "lines", "anchors", "summary"],
      "properties": {
        "file": { "type": "string" },
        "lines": { "type": "string", "pattern": "^[0-9]+(-[0-9]+)?$" },
        "anchors": {
          "type": "array",
          "items": { "type": "string" }
        },
        "summary": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
