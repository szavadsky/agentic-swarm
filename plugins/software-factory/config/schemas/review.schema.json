{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://software-factory/schemas/review.schema.json",
  "title": "ReviewArtifact",
  "type": "object",
  "required": ["status", "summary", "suggestions"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["approved", "changes_requested"]
    },
    "summary": { "type": "string" },
    "suggestions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "disposition", "summary"],
        "properties": {
          "id": { "type": "string" },
          "disposition": {
            "type": "string",
            "enum": [
              "fix",
              "optional",
              "architect",
              "human-awareness",
              "human-async",
              "human-stop",
              "dismiss"
            ]
          },
          "summary": { "type": "string" },
          "detail": { "type": "string" },
          "location": {
            "type": "object",
            "required": ["file"],
            "properties": {
              "file": { "type": "string" },
              "line": { "type": "integer" }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "newConcerns": {
      "type": "array",
      "description": "New concerns discovered during review",
      "items": {
        "type": "object", "required": ["kind", "summary"], "additionalProperties": false,
        "properties": {
          "kind": { "type": "string", "enum": ["tech-debt", "assumption", "blocker", "risk", "question"] },
          "summary": { "type": "string" }, "detail": { "type": "string" },
          "severity": { "type": "string", "enum": ["low", "medium", "high"] },
          "location": { "type": "object", "required": ["file"], "properties": { "file": { "type": "string" }, "line": { "type": "integer" } }, "additionalProperties": false },
          "affects": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  },
  "additionalProperties": false
}
