{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://software-factory/schemas/developer-output.schema.json",
  "title": "DeveloperOutputArtifact",
  "type": "object",
  "required": ["status", "summary"],
  "properties": {
    "status": {
      "type": "string",
      "description": "Step execution status (ok, blocked, failed)",
      "enum": ["ok", "blocked", "failed"]
    },
    "summary": {
      "type": "string",
      "description": "Concise summary of implementation actions and test results"
    },
    "target": {
      "description": "Target test selectors, gate, or custom command for red/green verification",
      "oneOf": [
        {
          "type": "object",
          "required": ["selectors", "expectRed"],
          "properties": {
            "selectors": {
              "type": "array",
              "items": { "type": "string" }
            },
            "expectRed": {
              "type": "array",
              "items": { "type": "string" },
              "minItems": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["gate"],
          "properties": {
            "gate": { "type": "string" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["command", "customTarget"],
          "properties": {
            "command": { "type": "string" },
            "customTarget": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      ]
    },
    "evidence": {
      "type": "array",
      "description": "List of executed checks and verification commands proving correctness",
      "items": { "type": "string" },
      "default": []
    },
    "concerns": {
      "type": "array",
      "description": "Structured concerns raised during implementation",
      "items": {
        "type": "object", "required": ["kind", "summary"], "additionalProperties": false,
        "properties": {
          "kind": { "type": "string", "enum": ["tech-debt", "assumption", "blocker", "risk", "question"] },
          "summary": { "type": "string" }, "detail": { "type": "string" },
          "severity": { "type": "string", "enum": ["low", "medium", "high"] },
          "location": { "type": "object", "required": ["file"], "properties": { "file": { "type": "string" }, "line": { "type": "integer" } }, "additionalProperties": false },
          "affects": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "remarkable": {
      "type": "array",
      "description": "Remarkable decisions or tradeoffs with the chosen option, alternatives, and why",
      "items": {
        "type": "object", "required": ["chosen", "alternatives", "why"], "additionalProperties": false,
        "properties": {
          "chosen": { "type": "string" }, "why": { "type": "string" },
          "alternatives": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "notes": {
      "type": "string",
      "description": "Optional developer notes, implementation observations, or comments"
    }
  },
  "additionalProperties": false
}
