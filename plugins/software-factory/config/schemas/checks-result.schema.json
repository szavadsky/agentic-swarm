{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://software-factory/schemas/checks-result.schema.json",
  "title": "ChecksResultArtifact",
  "type": "object",
  "required": ["checks"],
  "properties": {
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status"],
        "properties": {
          "id": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["pass", "fail", "skipped"]
          },
          "phase": {
            "type": "string",
            "enum": ["before", "after"]
          },
          "durationMs": { "type": "number" },
          "message": { "type": "string" },
          "details": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
