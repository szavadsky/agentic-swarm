{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://software-factory/schemas/triage.schema.json",
  "title": "TriageArtifact",
  "type": "object",
  "required": ["kind", "rationale", "citations"],
  "properties": {
    "kind": {
      "type": "string",
      "description": "Task hierarchy classification (simple, story, spike, epic, saga)",
      "enum": ["simple", "story", "spike", "epic", "saga"]
    },
    "rationale": {
      "type": "string",
      "description": "Explanation of classification rationale based on scope, risk, and design choices"
    },
    "size": {
      "type": "string",
      "description": "Estimated scope or line count as a string (e.g. '1 file, <20 lines')"
    },
    "risks": {
      "type": "array",
      "description": "Anticipated risks, uncertainties, or edge cases",
      "items": { "type": "string" }
    },
    "citations": {
      "type": "array",
      "description": "Verified citations in the codebase with anchors and line numbers",
      "items": { "$ref": "#/definitions/Citation" }
    }
  },
  "definitions": {
    "Citation": {
      "type": "object",
      "required": ["file", "lines", "anchors", "summary"],
      "properties": {
        "file": { "type": "string" },
        "lines": { "type": "string", "pattern": "^[0-9]+(-[0-9]+)?$" },
        "anchors": {
          "type": "array",
          "items": { "type": "string" }
        },
        "summary": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
