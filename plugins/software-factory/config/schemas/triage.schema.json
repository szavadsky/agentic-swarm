{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://software-factory/schemas/triage.schema.json",
  "title": "TriageArtifact",
  "type": "object",
  "required": ["kind", "rationale"],
  "properties": {
    "kind": {
      "type": "string",
      "enum": ["simple", "story", "spike", "epic", "saga"]
    },
    "rationale": { "type": "string" },
    "size": { "type": "string" },
    "risks": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
