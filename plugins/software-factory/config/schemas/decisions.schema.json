{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://software-factory/schemas/decisions.schema.json",
  "title": "DecisionArtifact",
  "type": "object",
  "required": ["decision"],
  "properties": {
    "id": { "type": "string", "description": "Unique identifier for this decision (assigned by engine if omitted)" },
    "context": {
      "type": "string",
      "description": "Decision context scope (item, non-item, wave, plan-closeup)",
      "enum": ["item", "non-item", "wave", "plan-closeup"]
    },
    "decision": {
      "type": "string",
      "description": "Architect decision verdict",
      "enum": [
        "retry-with-guidance",
        "split",
        "escalate",
        "accept-with-debt",
        "abandon",
        "fix-item",
        "human-async",
        "abort",
        "continue",
        "amend",
        "end-iteration",
        "complete",
        "next-iteration",
        "blocked"
      ]
    },
    "rationale": { "type": "string", "description": "Technical justification for this decision" },
    "text": { "type": "string", "description": "Concrete guidance or steering directives" },
    "persist": { "type": "boolean", "description": "Whether guidance persists across subsequent attempts" },
    "outlines": {
      "type": "array",
      "description": "Decomposed item outlines when decision is split",
      "items": { "type": "object" }
    },
    "outline": { "type": "object", "description": "Item outline to schedule when decision is fix-item" },
    "debt": { "type": "string", "description": "Technical debt description when decision is accept-with-debt" },
    "reason": { "type": "string", "description": "Reason for abandonment or abort" },
    "question": { "type": "string", "description": "Specific question for human operator when decision is human-async or blocked" },
    "planDelta": { "type": "string", "description": "Plan delta or amendment directives when decision is amend" },
    "timestamp": { "type": "string", "description": "ISO timestamp (assigned by engine if omitted)" },
    "concerns": {
      "type": "array",
      "description": "Structured concerns raised by the architect",
      "items": {
        "type": "object", "required": ["kind", "summary"], "additionalProperties": false,
        "properties": {
          "kind": { "type": "string", "enum": ["tech-debt", "assumption", "blocker", "risk", "question"] },
          "summary": { "type": "string" }, "detail": { "type": "string" },
          "severity": { "type": "string", "enum": ["low", "medium", "high"] },
          "location": { "type": "object", "required": ["file"], "properties": { "file": { "type": "string" }, "line": { "type": "integer" } }, "additionalProperties": false },
          "affects": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "remarkable": {
      "type": "array",
      "description": "Remarkable decisions or tradeoffs with the chosen option, alternatives, and why",
      "items": {
        "type": "object", "required": ["chosen", "alternatives", "why"], "additionalProperties": false,
        "properties": {
          "chosen": { "type": "string" }, "why": { "type": "string" },
          "alternatives": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "concernConfirms": {
      "type": "array",
      "description": "Architect confirmations for close-up concern resolutions",
      "items": {
        "type": "object", "required": ["id", "confirm"], "additionalProperties": false,
        "properties": {
          "id": { "type": "string" }, "note": { "type": "string" },
          "confirm": { "type": "string", "enum": ["accept", "reject"] }
        }
      }
    },
    "concernResolution": {
      "type": "object",
      "description": "Direct concern resolution applied when the decision commits",
      "required": ["id", "action"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" }, "note": { "type": "string" },
        "action": { "type": "string", "enum": ["resolve", "carry"] }
      }
    }
  },
  "additionalProperties": false
}
