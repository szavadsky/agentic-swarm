{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://software-factory/schemas/wave-closeup.schema.json",
  "title": "WaveCloseupArtifact",
  "type": "object",
  "required": ["wave", "iteration", "status", "mergedItems", "summary"],
  "properties": {
    "wave": { "type": "integer", "minimum": 1 },
    "iteration": { "type": "integer", "minimum": 1 },
    "status": {
      "type": "string",
      "enum": ["complete", "has_failures", "blocked"]
    },
    "mergedItems": {
      "type": "array",
      "items": { "type": "string" }
    },
    "failedItems": {
      "type": "array",
      "items": { "type": "string" }
    },
    "blockedItems": {
      "type": "array",
      "items": { "type": "string" }
    },
    "debt": {
      "type": "array",
      "items": { "type": "string" }
    },
    "summary": { "type": "string" },
    "recommendations": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
