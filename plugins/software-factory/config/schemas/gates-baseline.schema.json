{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://software-factory/schemas/gates-baseline.schema.json",
  "title": "GatesBaselineArtifact",
  "type": "object",
  "required": ["gates"],
  "properties": {
    "timestamp": { "type": "string" },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status"],
        "properties": {
          "id": { "type": "string" },
          "command": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["pass", "fail", "flaky"]
          },
          "durationMs": { "type": "number" },
          "details": { "type": "string" },
          "mutatesWorktree": { "type": "boolean" },
          "failingTests": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Test identifiers that failed or errored in baseline"
          },
          "collectionErrors": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Collection or suite errors in baseline"
          },
          "improvements": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Newly passing baseline test failures reported as improvements"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
