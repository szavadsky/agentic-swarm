{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://software-factory/schemas/assignment.schema.json",
  "title": "AssignmentArtifact",
  "type": "object",
  "required": ["slug", "kind", "title", "assignment"],
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "kind": { "type": "string" },
    "title": { "type": "string" },
    "assignment": { "type": "string" },
    "outlineRef": { "type": "string" },
    "milestone": { "type": "string" },
    "wave": { "type": "integer", "minimum": 1 },
    "deps": {
      "type": "array",
      "items": { "type": "string" }
    },
    "scenarioRefs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "citations": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string" },
          {
            "type": "object",
            "required": ["file", "lines", "anchors", "summary"],
            "properties": {
              "file": { "type": "string" },
              "lines": { "type": "string" },
              "anchors": {
                "type": "array",
                "items": { "type": "string" }
              },
              "summary": { "type": "string" }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "escalate": { "type": "boolean" }
  },
  "additionalProperties": false
}
