{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://software-factory/schemas/plan.schema.json",
  "title": "PlanArtifact",
  "type": "object",
  "required": ["iteration", "milestones", "itemOutlines"],
  "properties": {
    "iteration": { "type": "integer", "minimum": 1, "description": "Iteration number for this plan (minimum 1)" },
    "milestones": {
      "type": "array",
      "description": "Key delivery milestones for this iteration",
      "items": {
        "type": "object",
        "required": ["id", "title"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "scenarios": {
            "type": "array",
            "items": { "type": "string" }
          },
          "directionalInterfaces": {
            "type": "array",
            "items": { "type": "string" }
          },
          "replanAfter": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "uncertainties": {
      "type": "array",
      "description": "Identified technical or domain uncertainties to resolve via spikes",
      "items": {
        "type": "object",
        "required": ["id", "description"],
        "properties": {
          "id": { "type": "string" },
          "description": { "type": "string" },
          "spikeOutlines": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    },
    "itemOutlines": {
      "type": "array",
      "description": "Planned items/tasks to implement in this iteration",
      "items": {
        "type": "object",
        "required": ["slug", "kind", "title"],
        "properties": {
          "slug": { "type": "string" },
          "kind": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "milestoneId": { "type": "string" },
          "deps": {
            "type": "array",
            "items": { "type": "string" }
          },
          "escalate": { "type": "boolean" },
          "replanAfter": { "type": "boolean" },
          "prodBudgetHint": { "type": "integer", "minimum": 0, "description": "Advisory sizing hint: architect's estimated production lines changed for this item, for review against storyMaxProdLines/simpleMaxProdLines. Never blocks or fails the plan." }
        },
        "additionalProperties": false
      }
    },
    "assumptions": {
      "type": "array",
      "description": "Key assumptions made during planning",
      "items": {
        "type": "object",
        "required": ["assumption", "why"],
        "properties": {
          "assumption": { "type": "string" },
          "why": { "type": "string" },
          "disposition": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "epics": {
      "type": "array",
      "description": "Child epics to spawn (root tasks only)",
      "items": {
        "type": "object",
        "required": ["slug", "intent"],
        "properties": {
          "slug": { "type": "string" },
          "intent": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "techDebt": {
      "type": "array",
      "description": "Technical debt identified, categorized as adjacent, impacting, or blocking",
      "items": {
        "type": "object",
        "required": ["id", "description", "category"],
        "properties": {
          "id": { "type": "string" },
          "description": { "type": "string" },
          "category": {
            "type": "string",
            "enum": ["adjacent", "impacting", "blocking"]
          },
          "resolution": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "adrs": {
      "type": "array",
      "description": "Architecture Decision Records documented for major design choices",
      "items": {
        "type": "object",
        "required": ["id", "title", "context", "decision"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "context": { "type": "string" },
          "decision": { "type": "string" },
          "consequences": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
