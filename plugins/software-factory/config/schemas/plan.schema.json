{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://software-factory/schemas/plan.schema.json",
  "title": "PlanArtifact",
  "type": "object",
  "required": ["iteration", "milestones", "itemOutlines"],
  "properties": {
    "iteration": { "type": "integer", "minimum": 1, "description": "Iteration number for this plan (minimum 1)" },
    "milestones": {
      "type": "array",
      "description": "Key delivery milestones for this iteration",
      "items": {
        "type": "object",
        "required": ["id", "title"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "scenarios": {
            "type": "array",
            "items": { "type": "string" }
          },
          "directionalInterfaces": {
            "type": "array",
            "items": { "type": "string" }
          },
          "replanAfter": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "uncertainties": {
      "type": "array",
      "description": "Identified technical or domain uncertainties to resolve via spikes",
      "items": {
        "type": "object",
        "required": ["id", "description"],
        "properties": {
          "id": { "type": "string" },
          "description": { "type": "string" },
          "spikeOutlines": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    },
    "itemOutlines": {
      "type": "array",
      "description": "Planned items/tasks to implement in this iteration",
      "items": {
        "type": "object",
        "required": ["slug", "kind", "title"],
        "properties": {
          "slug": { "type": "string" },
          "kind": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "milestoneId": { "type": "string" },
          "deps": {
            "type": "array",
            "items": { "type": "string" }
          },
          "escalate": { "type": "boolean" },
          "replanAfter": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "assumptions": {
      "type": "array",
      "description": "Key assumptions made during planning",
      "items": {
        "type": "object",
        "required": ["assumption", "why"],
        "properties": {
          "assumption": { "type": "string" },
          "why": { "type": "string" },
          "disposition": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "epics": {
      "type": "array",
      "description": "Child epics to spawn (root tasks only)",
      "items": {
        "type": "object",
        "required": ["slug", "intent"],
        "properties": {
          "slug": { "type": "string" },
          "intent": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "techDebt": {
      "type": "array",
      "description": "Technical debt identified, categorized as adjacent, impacting, or blocking",
      "items": {
        "type": "object",
        "required": ["id", "description", "category"],
        "properties": {
          "id": { "type": "string" },
          "description": { "type": "string" },
          "category": {
            "type": "string",
            "enum": ["adjacent", "impacting", "blocking"]
          },
          "resolution": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "adrs": {
      "type": "array",
      "description": "Architecture Decision Records documented for major design choices",
      "items": {
        "type": "object",
        "required": ["id", "title", "context", "decision"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "context": { "type": "string" },
          "decision": { "type": "string" },
          "consequences": { "type": "string" },
          "blocking": {
            "type": "boolean",
            "description": "Needs a human decision per the active human-involvement mode; false/absent is remarkable (digest only)"
          }
        },
        "additionalProperties": false
      }
    },
    "concerns": {
      "type": "array",
      "description": "Structured concerns raised during planning",
      "items": {
        "type": "object", "required": ["kind", "summary"], "additionalProperties": false,
        "properties": {
          "kind": { "type": "string", "enum": ["tech-debt", "assumption", "blocker", "risk", "question"] },
          "summary": { "type": "string" }, "detail": { "type": "string" },
          "severity": { "type": "string", "enum": ["low", "medium", "high"] },
          "location": { "type": "object", "required": ["file"], "properties": { "file": { "type": "string" }, "line": { "type": "integer" } }, "additionalProperties": false },
          "affects": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "remarkable": {
      "type": "array",
      "description": "Remarkable decisions or tradeoffs with the chosen option, alternatives, and why",
      "items": {
        "type": "object", "required": ["chosen", "alternatives", "why"], "additionalProperties": false,
        "properties": {
          "chosen": { "type": "string" }, "why": { "type": "string" },
          "alternatives": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  },
  "additionalProperties": false
}
