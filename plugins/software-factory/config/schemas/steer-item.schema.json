{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://software-factory/schemas/steer-item.schema.json",
  "title": "SteerItemArtifact",
  "type": "object",
  "required": ["id", "ref", "disposition", "question", "status"],
  "properties": {
    "id": { "type": "string" },
    "ref": { "type": "string" },
    "disposition": { "type": "string" },
    "question": { "type": "string" },
    "draftDecision": { "type": "string" },
    "blocks": {
      "type": "array",
      "items": { "type": "string" }
    },
    "status": {
      "type": "string",
      "enum": ["open", "answered", "dismissed"],
      "default": "open"
    },
    "createdAt": { "type": "string" },
    "answeredAt": { "type": "string" },
    "answer": { "type": "string" }
  },
  "additionalProperties": false
}
