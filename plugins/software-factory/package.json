{
  "name": "software-factory",
  "type": "module",
  "private": true,
  "bin": {
    "factory": "./bin/factory.ts"
  },
  "scripts": {
    "factory": "bun run ./bin/factory.ts",
    "test": "bun test",
    "test:gate": "bun scripts/run-tests.ts",
    "typecheck": "tsc --noEmit",
    "format": "biome format .",
    "lint": "bun scripts/lint.ts && bun scripts/check-file-size.ts && bun scripts/real-names-gate.ts",
    "schema-validation": "bun src/schema-check.ts"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-draft-04": "^1.0.0",
    "ctrf": "^0.6.0",
    "diff": "^9.0.0",
    "junit-to-ctrf": "^0.2.0",
    "liquidjs": "^10.30.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@types/bun": "^1.2.0",
    "@types/sarif": "^2.1.7",
    "knip": "^6.45.1",
    "typescript": "^5.8.3"
  }
}
